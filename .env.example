PORT=3015
NODE_ENV=production

# Application URLs
FRONTEND_URL=https://chiyatown.com.np/
BACKEND_URL=https://genvixpos.genvixtech.com

# Database Connection Strings (Fill in real credentials on server)
MONGODB_URI=mongodb://username:password@127.0.0.1:27017/database_name?authSource=admin
SUPERADMIN_MONGODB_URI=mongodb://username:password@127.0.0.1:27017/superadmin_db_name?authSource=admin

# Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# SMTP Configuration
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=support@yourdomain.com
SMTP_PASS="your_smtp_password"
